---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
---

<BaseLayout title="Contact Archytum" description="Start a Business AI or Enterprise Azure & AI conversation with Archytum.">
  <PageHero eyebrow="Contact" title="Start with the problem—not a product pitch." lede="Choose the path that best matches your need. We will review the context, fit, risk, and appropriate next step." />
  <section class="section">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">What happens next</p>
        <h2>Clear expectations from the first message.</h2>
        <ul class="checklist">
          <li>Business inquiries acknowledged within one business day</li>
          <li>Enterprise inquiries personally reviewed within two business days</li>
          <li>A form or call does not create a client relationship</li>
          <li>Substantive enterprise guidance begins with a paid engagement</li>
        </ul>
        <div class="notice">
          <strong>Do not send sensitive information.</strong>
          Do not include passwords, authentication codes, private identifiers, payment credentials, regulated data, or confidential project materials.
        </div>
        <p>Form unavailable? Email <a href="mailto:blake@archytum.com">blake@archytum.com</a>.</p>
      </div>

      <div class="card">
        <form id="contact-form" action={formEndpoint || undefined} method="POST" data-endpoint-ready={Boolean(formEndpoint)} novalidate>
          <div class="form-grid">
            <div class="field full">
              <label for="path">What kind of help are you looking for?</label>
              <select id="path" name="buyer_path" required>
                <option value="">Select a path</option>
                <option value="business">Business AI Solutions</option>
                <option value="enterprise">Enterprise Azure & AI</option>
                <option value="unsure">Not sure yet</option>
              </select>
            </div>
            <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="email">Business email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="company">Organization</label><input id="company" name="organization" autocomplete="organization" required /></div>
            <div class="field"><label for="website">Website <span class="help">(optional)</span></label><input id="website" name="website" type="url" autocomplete="url" /></div>
            <div class="field business-field" hidden><label for="team-size">Approximate team size</label><select id="team-size" name="team_size"><option value="">Select</option><option>1–5</option><option>6–20</option><option>21–50</option><option>51+</option></select></div>
            <div class="field business-field" hidden><label for="workspace">Primary workspace</label><select id="workspace" name="workspace"><option value="">Select</option><option>Microsoft 365</option><option>Google Workspace</option><option>Other / mixed</option></select></div>
            <div class="field enterprise-field" hidden><label for="role">Your role</label><input id="role" name="role" autocomplete="organization-title" /></div>
            <div class="field enterprise-field" hidden><label for="budget">Approved budget range</label><select id="budget" name="budget"><option value="">Select</option><option>Under $15,000</option><option>$15,000–$50,000</option><option>$50,000–$150,000</option><option>$150,000+</option><option>Not approved yet</option></select></div>
            <div class="field full"><label for="need">What needs to change?</label><textarea id="need" name="need" required placeholder="Describe the workflow, initiative, decision, or outcome. Please keep this non-confidential."></textarea></div>
            <div class="field"><label for="timeline">Target timeline</label><select id="timeline" name="timeline"><option value="">Select</option><option>Within 30 days</option><option>1–3 months</option><option>3–6 months</option><option>6+ months</option><option>Exploring</option></select></div>
            <div class="field"><label for="source">How did you hear about Archytum?</label><input id="source" name="source" /></div>
            <div class="field full">
              <label class="consent"><input type="checkbox" name="contact_consent" required /><span>I agree that Archytum may use this information to respond to my inquiry. I have not included sensitive or confidential material.</span></label>
            </div>
            <input type="text" name="company_website_confirm" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
            <input type="hidden" name="_subject" value="New Archytum website inquiry" />
          </div>
          <button class="button teal" type="submit">Send inquiry</button>
          <p class="help">By submitting, you agree to the <a href="/privacy/">Privacy Notice</a>. Receipt does not mean acceptance of an engagement.</p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          {!formEndpoint && <p class="help"><strong>Local preview:</strong> submission is disabled until the approved Formspree endpoint is configured.</p>}
        </form>

        <p class="help">If an inquiry is a fit, meeting times are coordinated by email. Enterprise architecture time is not publicly bookable.</p>
      </div>
    </div>
  </section>

  <script>
    const pathSelect = document.querySelector<HTMLSelectElement>('#path');
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const businessFields = document.querySelectorAll<HTMLElement>('.business-field');
    const enterpriseFields = document.querySelectorAll<HTMLElement>('.enterprise-field');
    const params = new URLSearchParams(window.location.search);

    function updateFields() {
      const value = pathSelect?.value;
      businessFields.forEach((el) => el.hidden = value !== 'business');
      enterpriseFields.forEach((el) => el.hidden = value !== 'enterprise');
    }

    const requestedPath = params.get('path');
    if (pathSelect && (requestedPath === 'business' || requestedPath === 'enterprise')) pathSelect.value = requestedPath;
    updateFields();
    pathSelect?.addEventListener('change', updateFields);

    form?.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        if (status) status.textContent = 'Please complete the required fields.';
        return;
      }
      if (form.dataset.endpointReady !== 'true') {
        event.preventDefault();
        if (status) status.textContent = 'Submission is disabled in this local preview. No information was sent.';
      }
    });
  </script>
</BaseLayout>
