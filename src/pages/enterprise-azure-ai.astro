---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout title="Enterprise Azure & AI | Archytum" description="Azure architecture, AI engineering, platform strategy, governance, and delivery leadership.">
  <PageHero eyebrow="Enterprise Azure & AI" title="Architecture that can survive contact with production." lede="Architecture guidance and hands-on delivery for organizations building cloud foundations, AI platforms, integrations, and controlled agent systems." />

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Capabilities</p><h2>From a hard decision to a durable platform.</h2><p>Engage at the level the initiative actually requires—without disguising a large transformation as a short workshop.</p></div>
      <div class="grid-3">
        <article class="card"><h3>Azure architecture</h3><p>Landing zones, identity, networking, security, governance, observability, cost posture, and workload design.</p></article>
        <article class="card"><h3>Enterprise AI systems</h3><p>Application and agent architecture, retrieval, data boundaries, evaluation, safety, monitoring, and integration.</p></article>
        <article class="card"><h3>Delivery leadership</h3><p>Architecture decisions, roadmaps, technical governance, team guidance, risk management, and production readiness.</p></article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Engagement ladder</p><h2>Pay for the level of clarity and delivery you need.</h2></div>
      <div class="grid-4">
        <article class="card"><span class="tag">One decision</span><h3>Executive Architecture Session</h3><p class="price">$1,500</p><p>A 90-minute working session, pre-read, and written recommendations for one defined decision.</p></article>
        <article class="card"><span class="tag">Current to target</span><h3>Azure & AI Architecture Assessment</h3><p class="price"><small>Starting at</small> $15,000</p><p>Stakeholder discovery, current-state analysis, target architecture, risks, tradeoffs, and roadmap.</p></article>
        <article class="card"><span class="tag">Ongoing leadership</span><h3>Fractional Principal Architect</h3><p class="price"><small>Starting at</small> $7,500 <small>/ month</small></p><p>Defined architecture capacity without a full-time principal hire.</p></article>
        <article class="card"><span class="tag">Custom delivery</span><h3>Enterprise Platform Delivery</h3><p class="price">Custom</p><p>Platform foundations, AI systems, integration, governance, production readiness, and handoff.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Comparison</p><h2>A clear entry point without commoditizing complex delivery.</h2></div>
      <div class="comparison-wrap" tabindex="0" aria-label="Scrollable enterprise engagement comparison">
        <table class="comparison">
          <thead><tr><th scope="col">Engagement</th><th scope="col">Best for</th><th scope="col">Typical output</th><th scope="col">Pricing</th></tr></thead>
          <tbody>
            <tr><td>Architecture Session</td><td>One bounded decision</td><td>Written recommendations</td><td>$1,500 fixed</td></tr>
            <tr><td>Architecture Assessment</td><td>Investment or modernization planning</td><td>Target state and roadmap</td><td>From $15,000</td></tr>
            <tr><td>Fractional Principal</td><td>Ongoing architecture leadership</td><td>Decisions, governance, and guidance</td><td>From $7,500/month</td></tr>
            <tr><td>Platform Delivery</td><td>Custom build or transformation</td><td>Working platform and handoff</td><td>Custom proposal</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container grid-2">
      <div class="section-heading"><p class="eyebrow">Architecture principles</p><h2>Production is a system, not a model endpoint.</h2></div>
      <ul class="checklist">
        <li>Identity and authorization before feature expansion</li>
        <li>Data minimization, isolation, retention, and deletion</li>
        <li>Evaluation and observability tied to business risk</li>
        <li>Explicit approval for consequential actions</li>
        <li>Cost and operational ownership visible from the start</li>
      </ul>
    </div>
  </section>

  <CTA eyebrow="Enterprise inquiry" title="Bring one initiative, decision, or platform problem." text="Enterprise inquiries are reviewed before scheduling. Substantive guidance begins with a paid session or assessment." primaryLabel="Submit an enterprise inquiry" primaryHref="/contact/?path=enterprise" />
</BaseLayout>
