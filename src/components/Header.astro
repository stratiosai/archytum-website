---
const { path = '/' } = Astro.props;
const links = [
  { href: '/business-ai/', label: 'Business AI' },
  { href: '/enterprise-azure-ai/', label: 'Enterprise' },
  { href: '/work/', label: 'Work' },
  { href: '/insights/', label: 'Insights' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Archytum home">
      <span class="brand-mark" aria-hidden="true">A</span>
      <span>Archytum</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <a class="button" href="/contact/">Start a conversation</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
