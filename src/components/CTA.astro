---
const {
  eyebrow = 'Start with the right conversation',
  title = 'Bring the problem. We’ll clarify the next step.',
  text = 'Tell us what is changing, what is stuck, and what a useful outcome would look like.',
  primaryLabel = 'Start a conversation',
  primaryHref = '/contact/',
  secondaryLabel = 'See how we work',
  secondaryHref = '/work/'
} = Astro.props;
---

<section class="section dark">
  <div class="container grid-2">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div>
      <p style="color:#c7d6e9;font-size:1.12rem">{text}</p>
      <div class="hero-actions">
        <a class="button teal" href={primaryHref}>{primaryLabel}</a>
        <a class="button secondary" href={secondaryHref}>{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
